{
  "name": "oph",
  "version": "2.0.5",
  "description": "Personal CLI for everyday dev chores: bump pnpm/bun deps, self-update, and project housekeeping.",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/gen-version.js",
    "build": "tsc && tsc-alias",
    "build:bin": "node scripts/gen-version.js && tsc && tsc-alias && esbuild dist/index.js --bundle --platform=node --target=node22 --outfile=dist/bundle.js && pkg dist/bundle.js -t node22 --no-bytecode --public-packages \"*\" --public -o bin/oph",
    "start": "node dist/index.js",
    "check": "tsc --noEmit && biome check",
    "check:fix": "tsc --noEmit && biome check --fix"
  },
  "bin": {
    "oph": "dist/index.js"
  },
  "keywords": [],
  "author": "Philipp Opheys",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.9.1",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  }
}
