{
  "name": "oph",
  "version": "2.0.6",
  "description": "Personal CLI for everyday dev chores: bump pnpm/bun deps, self-update, and project housekeeping.",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/gen-version.js",
    "build": "tsc && tsc-alias",
    "build:bin": "node scripts/gen-version.js && tsc && tsc-alias && esbuild dist/index.js --bundle --platform=node --target=node22 --outfile=dist/bundle.js && pkg dist/bundle.js -t node22 --no-bytecode --public-packages \"*\" --public -o bin/oph",
    "start": "node dist/index.js",
    "check": "tsc --noEmit && biome check",
    "check:fix": "tsc --noEmit && biome check --fix"
  },
  "bin": {
    "oph": "dist/index.js"
  },
  "keywords": [],
  "author": "Philipp Opheys",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "ignore": "^7.0.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.9.5",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3"
  }
}
